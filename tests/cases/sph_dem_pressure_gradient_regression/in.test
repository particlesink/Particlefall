echo both

atom_style      hybrid sphere sph
atom_modify     map array sort 0 0
communicate     single vel yes
boundary        f f f
newton          off
units           si

region          reg block 0.0 0.06 0.0 0.02 0.0 0.02 units box
create_box      2 reg

create_atoms    1 single 0.020 0.010 0.010 units box
create_atoms    1 single 0.030 0.010 0.010 units box
create_atoms    2 single 0.025 0.010 0.010 units box

group           fluid type 1
group           solid type 2

mass            1 0.001
set             group fluid diameter 0.010
set             group fluid density 1000.0
set             atom 1 meso_rho 1100.0
set             atom 2 meso_rho 900.0

set             group solid diameter 0.010
set             group solid density 2500.0

velocity        fluid set 0.0 0.0 0.0 sum no units box
velocity        solid set 0.0 0.0 0.0 sum no units box

neighbor        0.003 bin
neigh_modify    exclude type 1 2
neigh_modify    exclude type 2 2

fix             m1 all property/global speedOfSound peratomtype 20.0 20.0
fix             m2 all property/global sl peratomtype 0.012 0.012
fix             m3 all property/global artViscAlpha peratomtype 4.1666e-3 4.1666e-3
fix             m4 all property/global artViscBeta peratomtype 0.0 0.0
fix             m5 all property/global artViscEta scalar 1.44e-6
fix             m6 all property/global tensCorrEpsilon scalar 0.2
fix             m7 all property/global tensCorrDeltaP peratomtype 0.010 0.010

pair_style      sph/artVisc/tensCorr cubicspline 0.012 artVisc tensCorr
pair_coeff      * *

fix             density fluid sph/density/continuity
fix             corr fluid sph/density/corr shepard every 10
fix             pressure fluid sph/pressure absolut 1.0

timestep        1.0e-4
fix             integrFluid fluid nve/sph
fix             integrSolid solid nve/sphere
fix             bridge all couple/sphdem fluid solid cubicspline 0.020 0.0
set             group fluid sphkernel cubicspline

variable        coupled_particles equal f_bridge[1]
variable        pressure_force_x equal f_bridge[5]
variable        porosity_sum equal f_bridge[8]

fix             metricCoupled all print 1 "TEST_METRIC coupled_particles=${coupled_particles}" screen yes
fix             metricPressureX all print 1 "TEST_METRIC pressure_force_x=${pressure_force_x}" screen yes
fix             metricPorosity all print 1 "TEST_METRIC porosity_sum=${porosity_sum}" screen yes

thermo_style    custom step atoms f_bridge[1] f_bridge[5] f_bridge[8]
thermo          1

run             1
