echo both

atom_style      granular
atom_modify     map array
boundary        m m m
newton          off
communicate     single vel yes
units           si

region          reg block -0.03 0.03 -0.03 0.03 0.0 0.05 units box
region          insreg block -0.015 0.015 -0.015 0.015 0.02 0.035 units box
create_box      1 reg

neighbor        0.002 bin
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5

pair_style      gran model hertz tangential history
pair_coeff      * *
timestep        1.0e-5

fix             grav all gravity 9.81 vector 0.0 0.0 -1.0
fix             zlo all wall/gran model hertz tangential history primitive type 1 zplane 0.0

fix             pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.003
fix             pdd1 all particledistribution/discrete 32452843 1 pts1 1.0
fix             ins1 all insert/pack seed 49979687 distributiontemplate pdd1 insert_every once &
                overlapcheck yes all_in no maxattempt 100 vel constant 0.0 0.0 0.0 &
                region insreg particles_in_region 2
fix             integr all nve/sphere

run             1
variable        natoms_before equal atoms
print           "TEST_METRIC natoms_before=${natoms_before}"

write_restart   state.restart

clear

read_restart    state.restart
newton          off
communicate     single vel yes
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix             grav all gravity 9.81 vector 0.0 0.0 -1.0
fix             zlo all wall/gran model hertz tangential history primitive type 1 zplane 0.0

run             0
variable        natoms_after equal atoms
print           "TEST_METRIC natoms_after=${natoms_after}"
