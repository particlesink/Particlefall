echo both

atom_style      granular
atom_modify     map array
boundary        m m m
newton          off
communicate     single vel yes
units           si

region          domain block -0.06 0.06 -0.06 0.06 -0.01 0.16 units box
create_box      1 domain

neighbor        0.002 bin
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5

pair_style      gran model hertz tangential history
pair_coeff      * *
timestep        1.0e-5

fix             grav all gravity 9.81 vector 0.0 0.0 -1.0
fix             hopper_mesh all mesh/surface file ../../../examples/mesh_inclusion_insert/meshes/cylinder_closed.stl type 1 scale 1.0
fix             hopper_wall all wall/gran model hertz tangential history mesh n_meshes 1 meshes hopper_mesh

fix             pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.004
fix             pdd1 all particledistribution/discrete 32452843 1 pts1 1.0

region          insreg block -0.030 0.030 -0.030 0.030 0.04 0.10 units box
fix             ins all insert/pack seed 49979687 distributiontemplate pdd1 insert_every once &
                overlapcheck yes all_in yes maxattempt 100 region insreg particles_in_region 8 &
                inside hopper_mesh 1 1 0 vel constant 0.0 0.0 -0.05
fix             integr all nve/sphere

run             1

variable        natoms equal atoms
print           "TEST_METRIC natoms=${natoms}"

