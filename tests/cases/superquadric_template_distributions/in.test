echo both

atom_style      superquadric
atom_modify     map array
boundary        m m m
newton          off
communicate     single vel yes
units           si

region          reg block -0.09 0.09 -0.03 0.03 0.0 0.08 units box
region          reg_left block -0.085 -0.03 -0.02 0.02 0.015 0.055 units box
region          reg_mid block -0.025 0.025 -0.02 0.02 0.015 0.055 units box
region          reg_right block 0.03 0.085 -0.02 0.02 0.015 0.055 units box
create_box      1 reg

neighbor        0.002 bin
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5
fix             m5 all property/global coefficientRollingFriction peratomtypepair 1 0.01
fix             m6 all property/global characteristicVelocity scalar 1.0
fix             m7 all property/global coefficientRollingViscousDamping peratomtypepair 1 0.0

pair_style      gran model hertz tangential history rolling_friction epsd2 surface superquadric
pair_coeff      * *
timestep        1.0e-5

fix             zlo all wall/gran model hertz tangential history rolling_friction epsd2 surface superquadric primitive type 1 zplane 0.0
fix             xlo all wall/gran model hertz tangential history rolling_friction epsd2 surface superquadric primitive type 1 xplane -0.09
fix             xhi all wall/gran model hertz tangential history rolling_friction epsd2 surface superquadric primitive type 1 xplane 0.09
fix             ylo all wall/gran model hertz tangential history rolling_friction epsd2 surface superquadric primitive type 1 yplane -0.03
fix             yhi all wall/gran model hertz tangential history rolling_friction epsd2 surface superquadric primitive type 1 yplane 0.03

fix             pts_shape all particletemplate/superquadric 15485863 atom_type 1 density constant 2500 &
                shape uniform 0.0015 0.0025 0.0015 0.0025 0.0050 0.0080 blockiness constant 8.0 2.0
fix             pts_axes all particletemplate/superquadric 15485867 atom_type 1 density constant 2500 &
                shape constant 0.0020 0.0020 0.0055 &
                blockiness constant 4.0 4.0
fix             pts_size all particletemplate/superquadric 32452843 atom_type 1 density constant 2500 &
                size uniform 0.0030 0.0050 blockiness constant 2.0 2.0

fix             pdd_shape all particledistribution/discrete 49979687 1 pts_shape 1.0
fix             pdd_axes all particledistribution/discrete 49979693 1 pts_axes 1.0
fix             pdd_size all particledistribution/discrete 67867967 1 pts_size 1.0

fix             ins_shape all insert/pack seed 32452867 distributiontemplate pdd_shape insert_every once &
                overlapcheck yes all_in no maxattempt 100 vel constant 0.0 0.0 0.0 &
                orientation random omega constant 0.0 0.0 0.0 &
                region reg_left particles_in_region 2
fix             ins_axes all insert/pack seed 86028121 distributiontemplate pdd_axes insert_every once &
                overlapcheck yes all_in no maxattempt 100 vel constant 0.0 0.0 0.0 &
                orientation random omega constant 0.0 0.0 0.0 &
                region reg_mid particles_in_region 2
fix             ins_size all insert/pack seed 86028157 distributiontemplate pdd_size insert_every once &
                overlapcheck yes all_in no maxattempt 100 vel constant 0.0 0.0 0.0 &
                orientation random omega constant 0.0 0.0 0.0 &
                region reg_right particles_in_region 2

fix             integr all nve/superquadric integration_scheme 1

run             1

variable        natoms equal atoms
print           "TEST_METRIC natoms=${natoms}"
