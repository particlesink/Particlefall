echo both

atom_style      granular
atom_modify     map array
boundary        m m m
newton          off
communicate     single vel yes
units           si

region          reg block -0.02 0.02 -0.02 0.02 0.0 0.04 units box
region          insreg block -0.005 0.005 -0.005 0.005 0.015 0.025 units box
create_box      1 reg

neighbor        0.002 bin
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5

pair_style      gran model hertz tangential history
pair_coeff      * *
timestep        1.0e-5

fix             pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2500 radius constant 0.0025
fix             pdd1 all particledistribution/discrete 32452843 1 pts1 1.0
fix             ins1 all insert/pack seed 49979687 distributiontemplate pdd1 insert_every once &
                overlapcheck yes all_in yes maxattempt 50 vel constant 0.0 0.0 0.0 &
                region insreg particles_in_region 1

dump            dmp all custom/vtk 1 sphere_schema_*.vtp type mass x y z id vx vy vz fx fy fz radius

run             1

variable        natoms equal atoms
print           "TEST_METRIC natoms=${natoms}"
