# in.hopper_2d.liggghts
#
# Purpose:
#   Quasi-2D DEM hopper in Packfall using a thin STL mesh hopper,
#   periodic boundary in z, and fix enforce2d.
#
# Coordinate system:
#   x = horizontal
#   y = vertical (gravity acts in -y)
#   z = thin periodic direction for 2D behaviour
#
# Workflow:
#   1) Create thin quasi-2D box
#   2) Add hopper wall mesh (thin STL extruded in z)
#   3) Add temporary horizontal gate below hopper tip
#   4) Insert particles above the outlet while gate is closed
#   5) Allow particles to settle
#   6) Remove gate and run discharge
#
# Notes:
#   - This deck follows the legacy public command style inherited into Packfall.
#   - The hopper walls are all in ONE mesh file because PUBLIC only supports
#     one mesh-style wall in fix wall/gran.
#   - Adjust geometry, material properties, particle size and run lengths to suit.

units              si
atom_style         granular
atom_modify        map array
boundary           f f p
#boundary           m m m 
newton             off
communicate        single vel yes
processors         * * 1

dimension          3

region             domain block -3.6 3.6 0.0 15.0 -1.0 1.0 units box
#region             domain block -3.6 3.6 0.0 15.0 -0.5 0.5 units box
create_box         1 domain

variable w equal 1.8
variable zneg equal -0.5*v_w
variable zpos equal  0.5*v_w

print ${w}
print ${zneg}
print ${zpos}

neighbor           0.01 bin
neigh_modify       delay 0 every 1 check yes

# ---------- material / contact model ----------
fix                 m1 all property/global youngsModulus peratomtype 5.0e6
fix                 m2 all property/global poissonsRatio peratomtype 0.30
fix                 m3 all property/global coefficientRestitution peratomtypepair 1 0.20
fix                 m4 all property/global coefficientFriction peratomtypepair 1 0.7
fix                 m5 all property/global coefficientRollingFriction peratomtypepair 1 0.50

pair_style          gran model hertz tangential history rolling_friction cdt
pair_coeff          * *

# ---------- walls ----------
fix                 hoppermesh all mesh/surface file FineOreBin-Extrude.stl type 1 scale 0.001
fix                 walls all wall/gran model hertz tangential history rolling_friction cdt mesh n_meshes 1 meshes hoppermesh

# Temporary gate just below hopper tip. Remove later with 'unfix gate'.
fix                 gate all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 yplane 0.01

#fix                 wall1 all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane ${zneg}
#fix                 wall2 all wall/gran model hertz tangential history rolling_friction cdt primitive type 1 zplane ${zpos}

# ---------- gravity / integration ----------
fix                 grav all gravity 9.81 vector 0.0 -1.0 0.0
fix                 integr all nve/sphere
#fix                 twod all enforce2d

timestep            1.0e-5

# ---------- particle definition ----------
# Example: monodisperse 8 mm ore-like spheres at 2500 kg/m^3
fix                 pts all particletemplate/sphere 15485863 atom_type 1 density constant 2500.0 radius constant 0.075
fix                 pdd all particledistribution/discrete 104729 1 pts 1.0

# ---------- insertion ----------
region              feed block -3.5 3.5 7.0 14.7  ${zneg} ${zpos} units box
region              feed2 block -0.5 0.5 13.0 14.7  ${zneg} ${zpos} units box

# Fill while gate is shut. 'once' inserts a single batch at the start.
#fix                 ins all insert/pack seed 86028121 distributiontemplate pdd \
#                    insert_every once overlapcheck yes all_in yes \
#                    particles_in_region 4500 region feed \
#                    vel constant 0.0 -0.10 0.0

#fix ins all insert/pack seed 86028121 distributiontemplate pdd insert_every once overlapcheck yes all_in yes particles_in_region 4500 region feed
fix ins all insert/rate/region seed 86028121 distributiontemplate pdd nparticles 1000000 particlerate 50000 insert_every 10000 overlapcheck yes region feed 

# ---------- output ----------
thermo              1000
thermo_style        custom step time atoms ke vol

shell               mkdir post

dump                dmp all custom/vtk 1000 post/hopper2d_*.vtk id type x y z vx vy vz radius fx fy fz omegax omegay omegaz

dump_modify         dmp sort id

# ---------- run sequence ----------
# Trigger insertion
run                 200000
unfix               ins
write_restart       post/after_insertion.restart

# Settle while gate is closed
run                 100000
write_restart       post/after_settling.restart

# Open outlet and discharge
unfix               gate
fix ins all insert/rate/region seed 86028121 distributiontemplate pdd nparticles 100000 particlerate 3000 insert_every 10000 overlapcheck yes region feed2 
run                 800000

write_restart       post/hopper2d_end.restart
