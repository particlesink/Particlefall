SHELL := /bin/bash

.PHONY: all headers stubs clean print-config help lib shlib

TARGET ?= packfall
BUILD_DIR ?= ../build/linux
OBJ_DIR := $(BUILD_DIR)/obj
DEP_DIR := $(BUILD_DIR)/dep
EXE := $(BUILD_DIR)/$(TARGET)
STATIC_LIB := $(BUILD_DIR)/lib$(TARGET).a
SHARED_LIB := $(BUILD_DIR)/lib$(TARGET).so
HEADER_STAMP := $(BUILD_DIR)/.headers.stamp

AR ?= ar
OPT ?= -O2
STD ?= -std=gnu++17
WARN ?= -Wall -Wextra -Wno-unused-result
PICFLAGS ?= -fPIC
SHLIBFLAGS ?= -shared

# Build mode:
#   USE_MPI=0 -> default single-process build against the MPI shim in src/STUBS
#   USE_MPI=1 -> opt in to the Linux MPI wrapper compiler
USE_MPI ?= 0
MPICXX ?= mpic++
SERIAL_CXX ?= g++

# Feature toggles:
#   ENABLE_GZIP=1 enables reading/writing .gz files via the gzip executable.
ENABLE_GZIP ?= 0
ENABLE_SUPERQUADRICS ?= 0

FEATURE_DEFS := -DLAMMPS_VTK
ifeq ($(ENABLE_GZIP),1)
FEATURE_DEFS += -DLAMMPS_GZIP
endif
ifeq ($(ENABLE_SUPERQUADRICS),1)
FEATURE_DEFS += -DSUPERQUADRIC_ACTIVE_FLAG -DNONSPHERICAL_ACTIVE_FLAG
endif

MPI_CPPFLAGS :=
MPI_LDFLAGS :=
MPI_LDLIBS :=
STUB_TARGET :=

ifeq ($(USE_MPI),1)
CXX := $(MPICXX)
LINK := $(MPICXX)
MPI_MODE := wrapper
else
CXX := $(SERIAL_CXX)
LINK := $(SERIAL_CXX)
MPI_MODE := stubs
MPI_CPPFLAGS += -ISTUBS
MPI_LDFLAGS += -LSTUBS
MPI_LDLIBS += -lmpi_stubs
STUB_TARGET := STUBS/libmpi_stubs.a
endif

CPPFLAGS += -I. $(FEATURE_DEFS) $(MPI_CPPFLAGS) $(EXTRA_CPPFLAGS)
CXXFLAGS += $(STD) $(OPT) $(WARN) $(EXTRA_CXXFLAGS)
LDFLAGS += $(MPI_LDFLAGS) $(EXTRA_LDFLAGS)
LDLIBS += $(MPI_LDLIBS) $(EXTRA_LDLIBS)

SRC := $(wildcard *.cpp)
OBJ := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(SRC))
LIB_SRC := $(filter-out main.cpp,$(SRC))
LIB_OBJ := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(LIB_SRC))
DEP := $(patsubst %.cpp,$(DEP_DIR)/%.d,$(SRC))

all: $(EXE)
lib: $(STATIC_LIB)
shlib: $(SHARED_LIB)

help:
	@echo "Linux build targets:"
	@echo "  make -f Makefile.linux                  build single-process with the MPI shim"
	@echo "  make -f Makefile.linux USE_MPI=1        opt in to a real MPI toolchain"
	@echo "  make -f Makefile.linux lib             build a static library"
	@echo "  make -f Makefile.linux shlib           build a shared library for Python/C callers"
	@echo "  make -f Makefile.linux print-config     show resolved toolchain settings"

print-config:
	@echo "TARGET=$(TARGET)"
	@echo "EXE=$(EXE)"
	@echo "STATIC_LIB=$(STATIC_LIB)"
	@echo "SHARED_LIB=$(SHARED_LIB)"
	@echo "USE_MPI=$(USE_MPI)"
	@echo "MPI_MODE=$(MPI_MODE)"
	@echo "CXX=$(CXX)"
	@echo "LINK=$(LINK)"
	@echo "CPPFLAGS=$(CPPFLAGS)"
	@echo "CXXFLAGS=$(CXXFLAGS)"
	@echo "LDFLAGS=$(LDFLAGS)"
	@echo "LDLIBS=$(LDLIBS)"
	@echo "ENABLE_GZIP=$(ENABLE_GZIP)"
	@echo "ENABLE_SUPERQUADRICS=$(ENABLE_SUPERQUADRICS)"

headers: $(HEADER_STAMP)

stubs: $(STUB_TARGET)

$(STUB_TARGET):
	@cd STUBS && rm -f libmpi_stubs.a mpi.o
	@cd STUBS && $(SERIAL_CXX) -O -c mpi.c -o mpi.o
	@cd STUBS && $(AR) rs libmpi_stubs.a mpi.o

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(OBJ_DIR):
	@mkdir -p $(OBJ_DIR)

$(DEP_DIR):
	@mkdir -p $(DEP_DIR)

$(HEADER_STAMP): | $(BUILD_DIR)
	@bash Make.sh style
	@bash Make.sh models
	@touch $@

$(EXE): $(HEADER_STAMP) $(STUB_TARGET) | $(BUILD_DIR) $(OBJ_DIR) $(DEP_DIR)
$(EXE): $(OBJ)
	$(LINK) $(CXXFLAGS) $(OBJ) $(LDFLAGS) $(LDLIBS) -o $@

$(STATIC_LIB): $(HEADER_STAMP) $(STUB_TARGET) | $(BUILD_DIR) $(OBJ_DIR) $(DEP_DIR)
$(STATIC_LIB): $(LIB_OBJ)
	$(AR) rs $@ $(LIB_OBJ)

$(SHARED_LIB): CXXFLAGS += $(PICFLAGS)
$(SHARED_LIB): $(HEADER_STAMP) $(STUB_TARGET) | $(BUILD_DIR) $(OBJ_DIR) $(DEP_DIR)
$(SHARED_LIB): $(LIB_OBJ)
	$(LINK) $(CXXFLAGS) $(SHLIBFLAGS) $(LIB_OBJ) $(LDFLAGS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: %.cpp $(HEADER_STAMP) $(STUB_TARGET) | $(OBJ_DIR) $(DEP_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MF $(DEP_DIR)/$*.d -c $< -o $@

clean:
	rm -rf $(BUILD_DIR)

-include $(DEP)
